# --- Frontend (safe for the browser; Vite exposes VITE_* only) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Edge Function secrets (NEVER put these in the frontend) ---
# Set with: supabase secrets set --env-file supabase/.env.functions
# See supabase/.env.functions.example
